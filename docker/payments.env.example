# Add these entries to docker/.env. Never commit real credentials.
# Disabled until credentials and the desired environment have been checked.
WHATOMATE_PAYMENTS__ENABLED=false
WHATOMATE_PAYMENTS__EFI_CONTINGENCY=false
WHATOMATE_PAYMENTS__MP_ACCESS_TOKEN=
# Optional authenticated webhook. Configure its HTTPS URL in Mercado Pago's dashboard.
WHATOMATE_PAYMENTS__MP_WEBHOOK_SECRET=
# Optional per-payment callback; HTTPS, applies only to new invoices.
WHATOMATE_PAYMENTS__MP_NOTIFICATION_URL=
WHATOMATE_PAYMENTS__EFI_CLIENT_ID=
WHATOMATE_PAYMENTS__EFI_CLIENT_SECRET=
WHATOMATE_PAYMENTS__EFI_PIX_KEY=
WHATOMATE_PAYMENTS__EFI_SANDBOX=true
WHATOMATE_PAYMENTS__EFI_CERTIFICATE=/run/payment-certs/efi.pem
# Leave empty if the PEM above also contains the private key.
WHATOMATE_PAYMENTS__EFI_PRIVATE_KEY=
